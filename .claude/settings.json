{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\" || true",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
