---
// Replaces Starlight's SocialIcons, which draws the site-wide `social` links of the config in the
// header and in the mobile menu. The site has no global account to link to; instead the one link
// shows the GitHub repository of the page being read: the plugin of a manual or reference page,
// uBot Manager under /manager/, else this site's repository (lib/repositories.mjs, repositoryForPage).
// The home page links to the roadmap Project instead (it overviews every repository).
// It is a long rounded rectangle with a sentence ("在 GitHub 查看 uBotSensor 仓库"), not a bare icon, so
// it reads as "the source of this page's package". It uses the page's content id, which has no base
// path, so it is the same on GitHub Pages.
import { Icon } from "@astrojs/starlight/components";
import index from "../../data/index.json";
import { createPackageRegistry } from "../../lib/packages.mjs";
import { repositoryForPage } from "../../lib/repositories.mjs";

const { entry } = Astro.locals.starlightRoute;
const repo = repositoryForPage(entry.id, createPackageRegistry(index));
---

<a href={repo.url} class="github-link" aria-label={repo.label} title={repo.kind === "project" ? `${repo.label}：各仓库的路线图和进度` : `${repo.label}：源码、问题（Issues）和发布版本`} data-repo={repo.name}>
  <Icon name="github" size="1.2rem" />
  <span class="text">在 GitHub 查看 <strong>{repo.name}</strong> {repo.noun}</span>
</a>

<style>
  .github-link {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.4rem 0.95rem 0.4rem 0.75rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.5rem;
    background-color: var(--sl-color-bg-nav);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
  }
  .github-link strong {
    color: var(--sl-color-text-accent);
    font-weight: 600;
  }
  .github-link:hover {
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-white);
  }

  /* Between 50rem and 72rem the header is tight (search, theme and language selects): shorten the
     sentence to the repository name. */
  @media (min-width: 50rem) and (max-width: 71.999rem) {
    .github-link .text {
      font-size: 0;
    }
    .github-link strong {
      font-size: var(--sl-text-sm);
    }
  }

  /* Below 50rem Starlight hides the header's right-hand group and shows the link in the mobile menu
     instead. A page without a sidebar (the home page) has no mobile menu, so there the header keeps
     the link, as an icon, and leaves out the theme and language selects as before. */
  @media (max-width: 49.999rem) {
    :global(:root:not([data-has-sidebar]) .header .github-link) {
      padding: 0.45rem;
    }
    :global(:root:not([data-has-sidebar]) .header .github-link .text) {
      display: none;
    }
    :global(:root:not([data-has-sidebar]) .header .right-group) {
      display: flex;
    }
    :global(:root:not([data-has-sidebar]) .header .right-group > :not(.social-icons)) {
      display: none;
    }
    :global(:root:not([data-has-sidebar]) .header .social-icons::after) {
      display: none;
    }
  }
</style>
