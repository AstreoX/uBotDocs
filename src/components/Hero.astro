---
// The hero of the home page (replaces Starlight's Hero, which only a page with `hero` frontmatter
// renders): title, tagline and buttons on the left, one Blueprint graph on the right. The graph is
// the thing the manuals are made of, so the first screen shows it. It is compiled here with the same
// code as a ```blueprint block; an invalid graph fails the build. The nodes sit in a fixed grid (`at`):
// the exec line on the top row, the data nodes below it, so that ten nodes stay four columns wide and
// the graph fits the right column without being scaled down much.
//
// Texts and buttons come from the `hero` frontmatter of src/content/docs/index.mdx.
import { LinkButton } from "@astrojs/starlight/components";
import { loadSite } from "../../lib/blueprint/site.mjs";
import { compileBlueprint } from "../../lib/blueprint/graph.mjs";
import { renderGraph } from "../../lib/blueprint/render.mjs";

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};

const SOURCE = `
caption: 读取 3D 激光雷达与 IMU 数据的蓝图示例，点击节点可查看说明与引脚。
nodes:
  A: { ref: UUBot3DLidarSensorComponent.On3DLidarFrameReady, component: Lidar3D, at: [0, 0] }
  C: { ref: K2Node_IfThenElse, at: [1, 0] }
  F: { ref: UKismetSystemLibrary.PrintString, at: [3, 0] }
  B: { ref: UUBotPointCloudFrame.GetPointByIndex, set: { Index: 0 }, at: [0, 1] }
  D: { ref: UKismetMathLibrary.VSize, at: [1, 1] }
  E: { ref: UKismetStringLibrary.Conv_DoubleToString, at: [2, 1] }
  G: { ref: UUBotImuSensorComponent.OnImuDataUpdated, component: IMU, at: [0, 2] }
  H: { ref: Break:FUBotImuSensorData, hideUnconnected: true, at: [1, 2] }
  I: { ref: UKismetMathLibrary.Quat_Rotator, at: [2, 2] }
  J: { ref: UKismetMathLibrary.BreakRotator, at: [3, 2] }
wires:
  - A.then -> C.execute
  - A.Frame -> B.Target
  - B.ReturnValue -> C.Condition
  - B.PointMeters -> D.A
  - D.ReturnValue -> E.InDouble
  - C.then -> F.execute
  - E.ReturnValue -> F.InString
  - G.Data -> H.UBotImuSensorData
  - H.OrientationQuaternion -> I.Q
  - I.ReturnValue -> J.Rotation
`;

const site = loadSite();
const { graph, diagnostics } = compileBlueprint(SOURCE, site.registry, { file: "src/components/Hero.astro" });
const errors = diagnostics.filter((d) => d.severity === "error");
if (errors.length || !graph) {
  throw new Error(`Invalid hero graph in src/components/Hero.astro\n${errors.map((d) => d.message).join("\n")}`);
}
const graphHtml = renderGraph(graph, { graphId: "bp-hero", registry: site.registry, overlay: site.overlay });
---

<div class="home-hero">
  <div class="copy">
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="actions">
          {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
            <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
              {text}
            </LinkButton>
          ))}
        </div>
      )
    }
  </div>
  <div class="demo" set:html={graphHtml} />
</div>

<style>
  @layer starlight.core {
    .home-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
      padding-block: 1.5rem 2rem;
    }
    .copy {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    h1 {
      font-size: clamp(var(--sl-text-4xl), calc(0.5rem + 6vw), 4.5rem);
      line-height: 1.05;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--sl-color-white);
    }
    .tagline {
      max-width: 38ch;
      text-wrap: balance;
      font-size: clamp(var(--sl-text-base), calc(0.0625rem + 1.6vw), var(--sl-text-base));
      line-height: 1.7;
      color: var(--sl-color-gray-2);
    }
    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1rem;
      align-items: center;
      margin-top: 0.5rem;
    }
    .demo {
      min-width: 0;
    }

    @media (min-width: 60rem) {
      .home-hero {
        grid-template-columns: minmax(0, 3.5fr) minmax(0, 7fr);
        align-items: center;
        gap: 2rem;
        padding-block: clamp(2rem, 7vmin, 5rem);
      }
    }
  }
</style>
