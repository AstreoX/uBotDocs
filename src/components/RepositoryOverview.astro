---
// The GitHub repositories of the project, for the home page and the introduction: first the
// recommendation to get uBot through uBot Manager, then one row per repository (name, what it holds,
// link to its manual in this site, link to GitHub). The plugin rows come from data/index.json through
// lib/packages.mjs (released plugins that have a GitHub repository, in index order), so a release adds
// a row without a page edit; uBot Manager and this site are fixed in lib/repositories.mjs.
//
//   import RepositoryOverview from "../../components/RepositoryOverview.astro";
//   <RepositoryOverview />
import { Icon } from "@astrojs/starlight/components";
import index from "../../data/index.json";
import { createPackageRegistry } from "../../lib/packages.mjs";
import { MANAGER_RELEASES_URL, repositoryOverview } from "../../lib/repositories.mjs";

const rows = repositoryOverview(createPackageRegistry(index));
---

<div class="repo-overview not-content">
  <p class="recommend">
    推荐用 <a href="/manager/">uBot Manager</a> 下载和管理 uBot：它为 UE 5.5 工程安装预编译的插件包，处理插件之间的依赖，并在有新版本时更新。{/* no line break here: it would render as a space after 。 */}GitHub 仓库用来查看源码、提交问题（Issues）和下载发布版本（Releases）。
  </p>
  <p class="recommend">
    Manager 的安装包在 <a href={MANAGER_RELEASES_URL}>uBotManager 的 Releases 页面</a>，步骤见<a href="/start/install/">安装 uBot</a>。
  </p>
  <ul class="repos">
    {rows.map((r) => (
      <li data-kind={r.kind}>
        <span class="name">{r.name}</span>
        <span class="desc">{r.description}</span>
        <span class="links">
          <a href={r.docsPath} class="manual">{r.manualLabel}</a>
          <a href={r.url} class="github" aria-label={`在 GitHub 上查看 ${r.name} 仓库`}>
            <Icon name="github" size="1em" />
            <span>GitHub</span>
          </a>
        </span>
      </li>
    ))}
  </ul>
</div>

<style>
  .recommend {
    margin: 0 0 0.6rem;
    font-size: var(--sl-text-sm);
    line-height: 1.7;
    color: var(--sl-color-gray-2);
  }
  .recommend a {
    color: var(--sl-color-text-accent);
  }
  .repos {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--sl-color-gray-5);
  }
  li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.15rem 1rem;
    margin: 0;
    padding: 0.6rem 0.5rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .name {
    grid-column: 1;
    grid-row: 1;
    font-weight: 600;
    color: var(--sl-color-text-accent);
    overflow-wrap: anywhere;
  }
  .desc {
    grid-column: 1 / -1;
    grid-row: 2;
    font-size: var(--sl-text-sm);
    line-height: 1.7;
    color: var(--sl-color-gray-2);
  }
  .links {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    gap: 1rem;
    align-items: center;
    font-size: var(--sl-text-sm);
  }
  .links a {
    color: var(--sl-color-text-accent);
    text-decoration: none;
    white-space: nowrap;
  }
  .links a:hover {
    color: var(--sl-color-white);
    text-decoration: underline;
  }
  .github {
    display: inline-flex;
    gap: 0.3em;
    align-items: center;
  }
  @media (min-width: 50rem) {
    li {
      grid-template-columns: 9.5rem 1fr 9rem;
      align-items: baseline;
      gap: 0 1rem;
    }
    .desc {
      grid-column: 2;
      grid-row: 1;
    }
    .links {
      grid-column: 3;
      justify-content: flex-end;
    }
  }
</style>
