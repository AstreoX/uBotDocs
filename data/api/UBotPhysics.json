    {
      "id": "UUBotPhysicsBindingComponent",
      "displayName": "uBot Physics Binding",
      "kind": "component",
      "parent": "UActorComponent",
      "module": "UBotPhysics",
      "header": "Source/UBotPhysics/Public/UBotPhysicsBindingComponent.h",
      "category": "uBot",
      "tooltip": "Hands components of its own actor to a physics backend: from Bind until Unbind the backend simulates\nthem instead of Chaos, is stepped on the uBot sim clock and moves the components every frame. The\ncomponent implements the uBotCore body state source interface for exactly the components it has bound,\nso sensors can read their true state; that lookup finds a source on the owner actor of a body, which is\nwhy a binding cannot hand over components of another actor.\n\nBinding is all or nothing and a body belongs to at most one binding. The bound components are made\nkinematic in Chaos (physics simulation off, collision settings untouched): queries and Chaos bodies\nstill see them, and they push Chaos bodies, but nothing pushes them back. Unbind restores the earlier\nsimulation state. When the backend is unregistered while bodies are bound, they go back to Chaos the\nsame way and the status becomes BackendMissing; Bind hands them to the backend again once it is registered.",
      "flags": {
        "abstract": false,
        "blueprintType": true,
        "blueprintable": true,
        "spawnable": true,
        "deprecated": false
      },
      "properties": [
        {
          "id": "Backend",
          "displayName": "Backend",
          "type": {
            "category": "name",
            "subtype": "",
            "subtypeDisplay": "",
            "container": "none",
            "valueType": null,
            "byRef": false,
            "const": false
          },
          "default": "None",
          "category": "Physics",
          "access": "readOnly",
          "editable": "anywhere",
          "tooltip": "Backend that simulates the bodies: the name an extension is registered under at the UBotPhysics.Backend extension point. Read when Bind is called.",
          "meta": {}
        },
        {
          "id": "Bodies",
          "displayName": "Bodies",
          "type": {
            "category": "struct",
            "subtype": "FUBotPhysicsBodyBinding",
            "subtypeDisplay": "UBot Physics Body Binding",
            "container": "array",
            "valueType": null,
            "byRef": false,
            "const": false
          },
          "default": "",
          "category": "Physics",
          "access": "readOnly",
          "editable": "anywhere",
          "tooltip": "The bodies to hand over; each must be a component of this actor. Empty: the owner's root component, which must be a primitive component.",
          "meta": {}
        },
        {
          "id": "bBindOnBeginPlay",
          "displayName": "Bind on Begin Play",
          "type": {
            "category": "bool",
            "subtype": "",
            "subtypeDisplay": "",
            "container": "none",
            "valueType": null,
            "byRef": false,
            "const": false
          },
          "default": "True",
          "category": "Physics",
          "access": "readOnly",
          "editable": "anywhere",
          "tooltip": "Binds when play begins. Turn it off to call Bind yourself, for example after the backend's model is ready.",
          "meta": {}
        }
      ],
